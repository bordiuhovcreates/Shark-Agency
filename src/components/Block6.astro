---
// Блок 6 — заклик: фото на фоні, блок збільшується при скролі, слова заголовка проявляються по черзі.
import home from '../content/home.json';
import { url } from '../lib/url';
import { words } from '../lib/words';
import ContactButton from './ContactButton.astro';

const { cta } = home;
---
<section
  class="section-06"
  id="block-6"
  style={`background-image: url('${url(cta.image)}')`}
  data-scene
  data-scrub-scale="2 37 0.7"
>
  <div class="_18px-neue white _36px-h-mob">{cta.eyebrow}</div>
  <div class="w-layout-vflex heading-button">
    <h2 class="_140px-formula _887px" data-scrub-words="30 3 3">
      {words(cta.title).map((w, i) => <>{i > 0 && ' '}<span>{w}</span></>)}
    </h2>
    <ContactButton label={cta.button} service="Ready to swim with sharks" variant="white" />
  </div>
  <div class="_30px-formula white _588px">{cta.text}</div>
</section>

<style is:global>
  .section-06 { background-position: 50%; background-size: cover; flex-flow: column; justify-content: flex-start; align-items: center; width: 100%; height: 85.125em; margin-top: var(--space-240); padding-top: var(--space-60); padding-bottom: var(--space-60); font-weight: 400; display: flex; position: relative; }
  .heading-button { grid-column-gap: var(--space-40); grid-row-gap: var(--space-40); align-items: center; margin-top: 28.8125em; }
  ._140px-formula { color: var(--color-white); text-align: center; margin-top: 0; margin-bottom: 0; font-family: var(--font-formula); font-size: var(--text-140); font-weight: 400; line-height: 1; }
  ._140px-formula._887px { width: 6.33571em; font-size: var(--text-140); }

  @media screen and (max-width: 479px) {
    .section-06 { justify-content: space-between; height: 54em; margin-top: var(--space-100); padding-top: var(--space-30); padding-bottom: var(--space-30); overflow: clip; }
    .heading-button { grid-column-gap: var(--space-20); grid-row-gap: var(--space-20); margin-top: 0; }
    ._140px-formula._887px { width: 5.04286em; font-size: var(--text-70); }
  }
</style>
