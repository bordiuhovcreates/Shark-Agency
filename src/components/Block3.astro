---
// Блок 3 — Performance snapshot: цифри виїжджають знизу при скролі, далі сітка аватарок команди.
import home from '../content/home.json';
import { url } from '../lib/url';
import { words } from '../lib/words';

const { performance } = home;
const pad = (n: number) => String(n).padStart(2, '0');
// Додаткові класи підписів (ширина рядка як у макеті)
const labelMods = ['', '_213px', '_131px-mob'];
---
<section id="about" class="section-03" data-scene>
  <h2 class="heading-110px _775px" data-scrub-words="9 3 6" data-scrub-words-mob="3 3 6">
    {words(performance.title).map((w, i) => <>{i > 0 && ' '}<span>{w}</span></>)}
  </h2>
  <div class="w-layout-vflex main-content-sec-3">
    {performance.stats.map((s, i) => (
      <div class="an-div">
        <div
          class={`w-layout-grid number _${(i % 3) + 1}-grid`}
          data-scrub-rise={`${31 + i * 6} ${37 + i * 6} 16`}
          data-scrub-rise-mob={`${25 + i * 6} ${31 + i * 6} 16`}
        >
          <div class={`_18px-neue orange ${labelMods[i % 3]}`}>{s.label}</div>
          <div class="_260px-formula">{s.value}</div>
          <div class="_18px-neue _40 auto none-mob num-end">{pad(i + 1)}</div>
        </div>
      </div>
    ))}
    <div class="an-team-4">
      <div class="w-layout-grid grid-team" data-scrub-rise="63 69 24" data-scrub-rise-mob="57 63 24">
        <div class="_18px-neue orange _270px team-text">{performance.teamText}</div>
        {performance.avatars.slice(0, 5).map((a, i) => (
          <img src={url(a.image)} loading="lazy" width="270" height="270" alt="" class={`team-member av-${i + 1}`} />
        ))}
        <div class="_18px-neue _40 auto none-mob team-num">{pad(performance.stats.length + 1)}</div>
        {performance.avatars.slice(5).map((a, i) => (
          <img src={url(a.image)} loading="lazy" width="270" height="270" alt="" class={`team-member av-${i + 6}`} />
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .section-03 { width: 100%; height: auto; margin-top: var(--space-240); padding-top: var(--space-40); padding-left: var(--space-40); padding-right: var(--space-40); }
  .main-content-sec-3 { grid-column-gap: var(--space-50); grid-row-gap: var(--space-50); margin-top: var(--space-100); }
  .number { grid-column-gap: 0px; grid-row-gap: 0px; border-top: var(--line-dotted); grid-template-rows: 13.625em; grid-template-columns: 38.75em 67.8125em 8.4375em; padding-top: var(--space-50); }
  .number .num-end { justify-self: end; }
  .an-div { height: 16.6em; overflow: hidden; }
  .an-team-4 { height: 24.6em; overflow: hidden; }
  .grid-team { grid-column-gap: var(--space-20); grid-row-gap: var(--space-20); border-top: var(--line-dotted); border-bottom: var(--line-dotted); grid-template: ". . . . . . . . . . . Area" ". . . . . . . . . . . ." / repeat(12, 8.4375em); width: auto; margin-bottom: 0; padding-top: var(--space-50); padding-bottom: var(--space-50); }
  .team-member { filter: grayscale(); color: #333; width: 8.4375em; height: 8.4375em; transition: filter var(--duration-slow); }
  .team-member:hover { filter: grayscale(0%); }

  /* Розташування елементів у сітці команди */
  .grid-team .team-text { grid-area: 1 / 1 / 2 / 3; }
  .grid-team .av-1 { grid-area: 1 / 3 / 2 / 4; }
  .grid-team .av-2 { grid-area: 1 / 4 / 2 / 5; }
  .grid-team .av-3 { grid-area: 1 / 7 / 2 / 8; }
  .grid-team .av-4 { grid-area: 1 / 9 / 2 / 10; }
  .grid-team .av-5 { grid-area: 1 / 10 / 2 / 11; }
  .grid-team .team-num { grid-area: 1 / 12 / 2 / 13; justify-self: end; }
  .grid-team .av-6 { grid-area: 2 / 5 / 3 / 6; }
  .grid-team .av-7 { grid-area: 2 / 6 / 3 / 7; }
  .grid-team .av-8 { grid-area: 2 / 7 / 3 / 8; }
  .grid-team .av-9 { grid-area: 2 / 9 / 3 / 10; }

  @media screen and (max-width: 479px) {
    .section-03 { margin-top: var(--space-100); padding-top: var(--space-20); padding-left: var(--space-20); padding-right: var(--space-20); overflow: clip; }
    .main-content-sec-3 { grid-column-gap: var(--space-40); grid-row-gap: var(--space-40); margin-top: var(--space-50); }
    .number { grid-template-rows: 3.625em; grid-template-columns: 11.25em 10.625em; padding-top: var(--space-40); }
    .grid-team { grid-column-gap: var(--space-10); grid-row-gap: var(--space-10); grid-template: "." "." "." "." / 5em 5em 5em 5em; grid-auto-columns: 1fr; padding-top: var(--space-40); padding-bottom: var(--space-40); }
    .team-member { width: 5em; height: 5em; }
    .an-div { height: 6.4em; }
    .an-team-4 { height: 27.1em; }
    .grid-team .av-3 { grid-area: 2 / 1 / 3 / 2; }
    .grid-team .av-4 { grid-area: 2 / 3 / 3 / 4; }
    .grid-team .av-5 { grid-area: 2 / 4 / 3 / 5; }
    .grid-team .av-6 { grid-area: 4 / 3 / 5 / 4; }
    .grid-team .av-7 { grid-area: 3 / 2 / 4 / 3; }
    .grid-team .av-8 { grid-area: 4 / 2 / 5 / 3; }
    .grid-team .av-9 { grid-area: 3 / 4 / 4 / 5; }
  }
</style>
