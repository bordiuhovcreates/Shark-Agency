---
// Юридична сторінка (Privacy Policy, Terms of Use): проста колонка по лівому краю, біле на чорному.
// Тексти — у src/content/legal.json.
import settings from '../content/settings.json';
import legal from '../content/legal.json';
import { url } from '../lib/url';
import CreditLink from './CreditLink.astro';

interface Props {
  doc: { title: string; updated: string; intro: string; sections: { title: string; text: string }[] };
  other: { title: string; href: string };
}
const { doc, other } = Astro.props;
const { common } = legal;
const { contacts, footer } = settings;
const phoneHref = `tel:${contacts.phone.replace(/\s/g, '')}`;

// Текст розділу: абзаци розділені порожнім рядком, рядки з «- » — маркований список
const blocks = (text: string) =>
  text.split(/\n\n/).map((block) => {
    const lines = block.split('\n');
    return lines.every((l) => l.startsWith('- ')) ? { list: lines.map((l) => l.slice(2)) } : { p: block };
  });
---
<div class="legal">
  <header class="legal__bar">
    <a href={url('/')} class="legal__logo" aria-label={settings.seo.title}>
      <img src={url(settings.header.logo)} width="57" height="57" alt="" class="legal__logo-img" />
    </a>
    <a href={url('/')} class="legal__link">{common.backLabel}</a>
  </header>

  <main class="legal__doc">
    <h1 class="legal__title">{doc.title}</h1>
    <p class="legal__meta">{common.updatedLabel}: {doc.updated}</p>
    <p class="legal__intro">{doc.intro}</p>

    {doc.sections.map((s) => (
      <section class="legal__section">
        <h2 class="legal__heading">{s.title}</h2>
        <div class="legal__text">
          {blocks(s.text).map((b) =>
            'list' in b
              ? <ul>{b.list.map((item) => <li>{item}</li>)}</ul>
              : <p>{b.p}</p>
          )}
        </div>
      </section>
    ))}
  </main>

  <footer class="legal__footer">
    <a href={`mailto:${contacts.email}`} class="legal__link">{contacts.email}</a>
    <a href={phoneHref} class="legal__link">{contacts.phone}</a>
    <a href={url(other.href)} class="legal__link">{other.title}</a>
    <span class="legal__copy">{footer.copyright}</span>
    <CreditLink />
  </footer>
</div>

<style is:global>
  .legal { padding: var(--space-40); min-height: 100svh; display: flex; flex-direction: column; color: var(--color-white); }

  .legal__bar { display: flex; justify-content: space-between; align-items: center; }
  .legal__logo { display: inline-block; }
  .legal__logo-img { width: 3.5625em; height: 3.5625em; }

  .legal__link { font-family: var(--font-neue); font-size: var(--text-18); line-height: 1; color: var(--color-white); transition: opacity var(--duration); }
  .legal__link:hover { opacity: .4; }

  .legal__doc { width: 100%; max-width: 50em; margin-top: var(--space-100); flex: 1; text-align: left; }
  .legal__title { margin: 0; font-family: var(--font-formula); font-size: var(--text-70); font-weight: 400; line-height: 1; }
  .legal__meta { margin: var(--space-20) 0 0; font-family: var(--font-neue); font-size: var(--text-18); line-height: 1.5; }
  .legal__intro { margin: var(--space-30) 0 0; font-family: var(--font-neue); font-size: var(--text-18); line-height: 1.5; }

  .legal__section { margin-top: var(--space-50); }
  .legal__heading { margin: 0 0 var(--space-10); font-family: var(--font-formula); font-size: var(--text-30); font-weight: 400; line-height: 1.1; }
  .legal__text { display: flex; flex-direction: column; gap: var(--space-10); font-family: var(--font-neue); font-size: var(--text-18); line-height: 1.5; }
  .legal__text p { margin: 0; }
  .legal__text ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: .4em; }

  .legal__footer { display: flex; flex-wrap: wrap; gap: var(--space-20) var(--space-40); margin-top: var(--space-100); padding-top: var(--space-40); }
  .legal__copy { font-family: var(--font-neue); font-size: var(--text-18); line-height: 1; }
  .legal__footer ._18px-neue.credit-link { font-size: var(--text-18); }

  @media screen and (max-width: 479px) {
    .legal { padding: var(--space-20); }
    .legal__logo-img { width: 1.875em; height: 1.875em; }
    .legal__link, .legal__copy, .legal__footer ._18px-neue.credit-link { font-size: var(--text-14); }
    .legal__doc { margin-top: var(--space-60); }
    .legal__title { font-size: var(--text-50); }
    .legal__meta, .legal__intro, .legal__text { font-size: var(--text-14); }
    .legal__section { margin-top: var(--space-40); }
    .legal__heading { font-size: var(--text-22); }
    .legal__footer { margin-top: var(--space-60); flex-direction: column; }
  }
</style>
