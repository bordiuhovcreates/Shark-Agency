---
// Юридична сторінка (Privacy Policy, Terms of Use). Тексти — у src/content/legal.json.
// Ліворуч: надзаголовок, заголовок, підзаголовок і дата (прилипають при скролі).
// Праворуч: розділи з номерами.
import settings from '../content/settings.json';
import legal from '../content/legal.json';
import { url } from '../lib/url';
import CreditLink from './CreditLink.astro';

interface Props {
  doc: { title: string; updated: string; intro: string; sections: { title: string; text: string }[] };
  other: { title: string; href: string };
}
const { doc, other } = Astro.props;
const { common } = legal;
const { contacts, footer } = settings;
const pad = (n: number) => String(n).padStart(2, '0');
const phoneHref = `tel:${contacts.phone.replace(/\s/g, '')}`;

// Текст розділу: абзаци розділені порожнім рядком, рядки з «- » — маркований список
const blocks = (text: string) =>
  text.split(/\n\n/).map((block) => {
    const lines = block.split('\n');
    return lines.every((l) => l.startsWith('- ')) ? { list: lines.map((l) => l.slice(2)) } : { p: block };
  });
---
<div class="legal">
  <header class="legal__bar">
    <a href={url('/')} class="legal__logo" aria-label={settings.seo.title}>
      <img src={url(settings.header.logo)} width="57" height="57" alt="" class="legal__logo-img" />
    </a>
    <a href={url('/')} class="legal__back"><span class="_18px-fomula">{common.backLabel}</span></a>
  </header>

  <main class="legal__main">
    <div class="legal__intro">
      <div class="_18px-neue orange legal__eyebrow">{common.eyebrow}</div>
      <h1 class="heading-110px legal__title">{doc.title}</h1>
      <p class="_30px-formula white legal__lead">{doc.intro}</p>
      <p class="_18px-neue _40 legal__updated">{common.updatedLabel}: {doc.updated}</p>
    </div>

    <div class="legal__content">
      {doc.sections.map((s, i) => (
        <section class="legal__section">
          <div class="_18px-neue orange legal__num">{pad(i + 1)}</div>
          <div class="legal__body">
            <h2 class="_30px-formula white legal__heading">{s.title}</h2>
            <div class="legal__text">
              {blocks(s.text).map((b) =>
                'list' in b
                  ? <ul>{b.list.map((item) => <li>{item}</li>)}</ul>
                  : <p>{b.p}</p>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>
  </main>

  <footer class="legal__footer">
    <div class="legal__contact footer-contact">
      <div class="_18px-neue _40 _10-margine">{common.contactLabel}</div>
      <a href={`mailto:${contacts.email}`} class="_18px-neue white foot">{contacts.email}</a>
      <a href={phoneHref} class="_18px-neue white foot">{contacts.phone}</a>
    </div>
    <div class="legal__contact footer-contact">
      <div class="_18px-neue _40 _10-margine">{common.addressLabel}</div>
      <div class="_18px-neue white legal__address">{contacts.address}</div>
    </div>
    <div class="legal__contact footer-contact">
      <div class="_18px-neue _40 _10-margine">{common.otherLabel}</div>
      <a href={url(other.href)} class="_18px-neue white foot">{other.title}</a>
    </div>
    <div class="legal__contact footer-contact legal__credits">
      <div class="_18px-neue white _40 auto">{footer.copyright}</div>
      <CreditLink />
    </div>
  </footer>
</div>

<style is:global>
  .legal { padding: var(--space-40); min-height: 100svh; display: flex; flex-direction: column; }

  .legal__bar { display: flex; justify-content: space-between; align-items: center; }
  .legal__logo { display: inline-block; }
  .legal__logo-img { width: 3.5625em; height: 3.5625em; }
  .legal__back { border: 1px dotted var(--color-white-20); width: 8.4375em; height: 4.375em; border-radius: var(--radius-5); display: flex; justify-content: center; align-items: center; padding-top: .2em; transition: background-color var(--duration); }
  .legal__back ._18px-fomula { transition: color var(--duration); }
  .legal__back:hover { background-color: var(--color-white); }
  .legal__back:hover ._18px-fomula { color: var(--color-black); }

  .legal__main { display: flex; justify-content: space-between; align-items: flex-start; margin-top: var(--space-100); flex: 1; }
  .legal__intro { position: sticky; top: var(--space-40); width: 38.75em; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-30); }
  ._18px-neue.legal__eyebrow { width: auto; }
  .legal__title { margin: 0; width: auto; }
  .legal__lead { margin: 0; width: 15.5em; text-align: left; }
  ._18px-neue.legal__updated { margin: 0; width: auto; }

  .legal__content { width: 56.875em; }
  .legal__section { display: grid; grid-template-columns: 6.25em 1fr; border-top: var(--line-dotted); padding-top: var(--space-30); padding-bottom: var(--space-60); }
  ._18px-neue.legal__num { width: auto; }
  .legal__heading { margin: 0; width: auto; }
  .legal__body { display: flex; flex-direction: column; gap: var(--space-20); }
  .legal__text { display: flex; flex-direction: column; gap: var(--space-10); font-family: var(--font-neue); font-size: var(--text-18); line-height: 1.3; color: var(--color-white-60); }
  .legal__text p { margin: 0; }
  .legal__text ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: .4em; }

  .legal__footer { display: grid; grid-template-columns: repeat(4, 1fr); column-gap: var(--space-20); row-gap: var(--space-60); border-top: var(--line-dotted); padding-top: var(--space-40); margin-top: var(--space-100); }
  ._18px-neue.legal__address { width: 12em; }
  .legal__credits { justify-self: end; align-items: flex-start; }

  @media screen and (max-width: 767px) {
    .legal__main { flex-direction: column; gap: var(--space-60); }
    .legal__intro { position: static; width: 100%; }
    .legal__content { width: 100%; }
    .legal__footer { grid-template-columns: 1fr 1fr; }
  }

  @media screen and (max-width: 479px) {
    .legal { padding: var(--space-20); }
    .legal__logo-img { width: 1.875em; height: 1.875em; }
    .legal__back { width: 5.5em; height: 2.5em; }
    .legal__main { margin-top: var(--space-60); gap: var(--space-50); }
    .legal__intro { gap: var(--space-20); }
    .legal__title { font-size: var(--text-50); }
    .legal__lead { width: 100%; font-size: var(--text-22); }
    .legal__section { grid-template-columns: 3.5em 1fr; padding-bottom: var(--space-40); }
    .legal__heading { font-size: var(--text-22); }
    .legal__text { font-size: var(--text-14); line-height: 1.35; }
    .legal__footer { margin-top: var(--space-60); row-gap: var(--space-40); }
    ._18px-neue.legal__address { width: 100%; }
    .legal__credits { justify-self: start; }
  }
</style>
