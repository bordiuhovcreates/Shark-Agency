---
// Шапка першого екрана: логотип, меню-«таблетка», кнопка Contact Us, кнопка Menu (мобільна).
import settings from '../content/settings.json';
import { url } from '../lib/url';

const { header } = settings;
---
<nav class="w-layout-hflex menu" aria-label="Main menu">
  <a href={url('/')} aria-current="page" class="link-logo" aria-label={settings.seo.title}>
    <img src={url(header.logo)} width="57" height="57" alt="" class="logo" />
  </a>
  <button type="button" class="button-menu pc" data-popup-open="Header">
    <span class="_18px-fomula">{header.button}</span>
  </button>
  <button type="button" class="menu-mobile" data-menu-open aria-haspopup="dialog">
    <span class="_18px-fomula">{header.menuButton}</span>
  </button>
  <div class="w-layout-hflex menu-bullit">
    {header.nav.map((l) => (
      <a href={l.href} class="bullit"><span class="_18px-fomula">{l.label}</span></a>
    ))}
  </div>
</nav>

<style is:global>
  .menu { z-index: 10; pointer-events: auto; justify-content: space-between; align-items: center; position: relative; }
  .link-logo { max-width: 100%; display: inline-block; }
  .logo { width: 3.5625em; height: 3.5625em; }
  .button-menu { border: 1px dotted var(--color-white-20); width: 8.4375em; height: 4.375em; color: var(--color-white-5); background-color: var(--color-transparent); border-radius: var(--radius-5); justify-content: center; align-items: center; padding-top: .2em; display: flex; transition: background-color var(--duration); }
  .button-menu.pc { cursor: pointer; }
  .button-menu ._18px-fomula, .bullit ._18px-fomula { transition: color var(--duration); }
  .button-menu:hover { background-color: var(--color-white); }
  .button-menu:hover ._18px-fomula { color: var(--color-black); }
  .menu-bullit { grid-column-gap: var(--space-10); grid-row-gap: var(--space-10); border: 1px dotted var(--color-white-20); background-color: var(--color-white-5); -webkit-backdrop-filter: blur(var(--blur-glass)); backdrop-filter: blur(var(--blur-glass)); width: 24em; color: var(--color-white-20); border-radius: var(--radius-5); justify-content: center; align-items: center; margin-left: auto; margin-right: auto; padding: .6em .6em .6em var(--space-10); position: absolute; inset: 0% 0% auto; }
  .bullit { border: 1px dotted var(--color-white-20); height: 3.125em; color: var(--color-white); cursor: pointer; border-radius: var(--radius-5); justify-content: center; align-items: center; padding-top: .2em; padding-left: var(--space-20); padding-right: var(--space-20); text-decoration: none; display: flex; transition: background-color var(--duration); }
  .bullit:hover { background-color: var(--color-orange); }
  .bullit:hover ._18px-fomula { color: var(--color-black); }
  .menu-mobile { border: 1px dotted var(--color-white-20); width: 8.4375em; height: 4.375em; color: var(--color-white-5); background-color: var(--color-transparent); border-radius: var(--radius-5); justify-content: center; align-items: center; padding-top: .2em; display: none; }

  @media screen and (max-width: 991px) { .menu-bullit { width: 28.1em; } }
  @media screen and (max-width: 767px) { .menu-bullit { width: 28.4em; } }
  @media screen and (max-width: 479px) {
    .logo { width: 1.875em; height: 1.875em; }
    .button-menu.pc { display: none; }
    .menu-bullit { display: none; }
    .menu-mobile { cursor: pointer; width: 3.75em; height: 2.5em; display: flex; }
    .menu-mobile.absolute { border-color: var(--color-black-30); position: absolute; inset: var(--space-20) var(--space-20) auto auto; }
  }
</style>
