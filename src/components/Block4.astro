---
// Блок 4 — послуги: картки-«стопка» (кожна прилипає до верху екрана), фото чергується зліва/справа.
import home from '../content/home.json';
import { url } from '../lib/url';

const { services } = home;
const pad = (n: number) => String(n).padStart(2, '0');
// Ширина опису в кожній картці — як у макеті
const textMods = ['_451px', 'text-card-2', 'text-card-3', 'text-card-4'];
---
<section id="service" class="section-04">
  {services.map((s, i) => {
    const reversed = i % 2 === 1;
    const text = (
      <div class:list={['w-layout-vflex', 'text-card', { border: reversed }]}>
        <div class="_18px-neue orange _12px-mob">{pad(i + 1)}</div>
        <h2 class:list={['_110px---formula', 'white', { _663px: i % 4 >= 2 }]} data-anim="fade-late">{s.title}</h2>
        <div class={`_18px-neue orange ${textMods[i % 4]}`}>{s.text}</div>
      </div>
    );
    const photo = (
      <div class:list={['photo-service', { 'no-border': reversed }]}>
        <img src={url(s.image)} loading="lazy" width="1260" height="1290" alt="" class="photo" />
      </div>
    );
    return (
      <div class="wrapper-card">
        <div class:list={['w-layout-hflex', 'card-service', { 'grid-mob': reversed }]}>
          {reversed ? <>{photo}{text}</> : <>{text}{photo}</>}
        </div>
      </div>
    );
  })}
</section>

<style is:global>
  .section-04 { width: 100%; height: auto; margin-top: var(--space-240); padding-left: var(--space-40); padding-right: var(--space-40); }
  .wrapper-card { width: 100%; height: 100svh; padding-top: var(--space-40); padding-bottom: var(--space-40); position: sticky; top: 0; }
  .card-service { border: var(--line-dotted); background-color: var(--color-black); border-radius: var(--radius-10); width: 100%; height: 100%; }
  .text-card { justify-content: space-between; align-items: center; width: 50%; height: 100%; padding-top: var(--space-40); padding-bottom: var(--space-40); }
  .text-card.border { border-left: var(--line-dotted); }
  .text-card h2 { margin: 0; font-weight: 400; }
  .photo-service { border-left: var(--line-dotted); width: 50%; height: 100%; padding: var(--space-40); }
  .photo-service.no-border { border-left-style: none; }
  .photo { object-fit: cover; border-radius: var(--radius-10); height: 100%; max-height: 100%; }

  @media screen and (max-width: 479px) {
    .section-04 { margin-top: var(--space-100); padding-left: var(--space-20); padding-right: var(--space-20); overflow: clip; }
    .wrapper-card { padding-top: var(--space-20); padding-bottom: var(--space-20); }
    .card-service { border-radius: var(--radius-5); flex-flow: column; }
    /* Дві рівні половини: фото не розтягує рядок за своїми пропорціями і не вилазить за обводку на низьких екранах */
    .card-service.grid-mob { grid-column-gap: 0px; grid-row-gap: 0px; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); grid-template-columns: 1fr; grid-auto-columns: 1fr; display: grid; }
    .card-service.grid-mob > * { min-height: 0; }
    .text-card { width: 100%; height: 50%; padding-top: var(--space-20); padding-bottom: var(--space-20); }
    .text-card.border { border-top: 1px var(--color-black); border-left-style: none; height: 100%; grid-area: 1 / 1 / 2 / 2; }
    .photo-service { border-top: var(--line-dotted); border-left-style: none; width: 100%; height: 50%; padding: var(--space-20); }
    .photo-service.no-border { height: 100%; }
    .photo { border-radius: var(--radius-5); }
  }
</style>
