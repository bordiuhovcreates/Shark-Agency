---
import Base from '../layouts/Base.astro';
import Block1 from '../components/Block1.astro';
import Block2 from '../components/Block2.astro';
import Block3 from '../components/Block3.astro';
import Block4 from '../components/Block4.astro';
import Block5 from '../components/Block5.astro';
import Block6 from '../components/Block6.astro';
import Block7 from '../components/Block7.astro';
import Footer from '../components/Footer.astro';
import Popup from '../components/Popup.astro';
import MobileMenu from '../components/MobileMenu.astro';
import settings from '../content/settings.json';
---
<Base>
  <!-- Перший екран і фраза: спільна сцена для Lottie-акули -->
  <main class="main-anim-wrapper" data-scene>
    <Block1 />
    <Block2 />
  </main>
  <Block3 />
  <Block4 />
  <Block5 />
  <Block6 />
  <Block7 />
  <Footer />
  <Popup />
  <MobileMenu />
  <div class="_18px-fomula _30 fixed" aria-hidden="true">{settings.scrollIndicator}</div>
</Base>

<style is:global>
  .main-anim-wrapper { display: block; pointer-events: auto; }
  @media screen and (max-width: 479px) {
    .main-anim-wrapper { overflow: clip; }
  }
</style>
